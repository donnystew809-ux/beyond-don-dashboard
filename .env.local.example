# --- Supabase ---------------------------------------------------------------
# From Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- PriceLabs --------------------------------------------------------------
# Account → Settings → API
PRICELABS_API_KEY=

# --- Turno ------------------------------------------------------------------
# Request from Turno support if not visible in the UI
TURNO_API_KEY=

# --- Anthropic (Listing Optimizer) ------------------------------------------
# console.anthropic.com → API Keys → Create Key. Used by /optimizer.
ANTHROPIC_API_KEY=

# --- Cron auth --------------------------------------------------------------
# A long random string. Vercel Cron sends this as Bearer token automatically
# when set via Vercel env vars.
CRON_SECRET=
